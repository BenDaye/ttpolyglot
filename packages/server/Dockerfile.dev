# TTPolyglot 开发环境 Dockerfile
# 用于开发时的热重载和代码监听

FROM dart:stable

# 安装额外的开发工具
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  postgresql-client \
  git \
  vim \
  inotify-tools && \
  rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app/packages/server

# 创建必要的目录
RUN mkdir -p /app/data /app/logs /app/uploads

# 先复制本地依赖包
COPY packages/model /app/packages/model
COPY packages/translators /app/packages/translators

# 复制 pubspec 文件
COPY packages/server/pubspec.yaml packages/server/pubspec_overrides.yaml ./

# 移除 workspace resolution 配置
RUN sed -i '/^resolution: workspace$/d' pubspec.yaml

# 预先安装依赖（加速后续启动）
RUN dart pub get

# 创建 migrate 脚本的符号链接
RUN echo '#!/bin/sh\ncd /app/packages/server && dart run database/migrate.dart "$@"' > /app/migrate && \
  chmod +x /app/migrate

# 创建热重载启动脚本
RUN echo '#!/bin/bash\n\
  set -e\n\
  \n\
  echo "🔥 开发模式：启用代码热重载"\n\
  echo "📁 监听目录：lib/ bin/ database/ scripts/"\n\
  echo ""\n\
  \n\
  # 信号处理函数\n\
  cleanup() {\n\
  echo ""\n\
  echo "🛑 收到停止信号，正在关闭服务..."\n\
  kill $SERVER_PID 2>/dev/null || true\n\
  wait $SERVER_PID 2>/dev/null || true\n\
  exit 0\n\
  }\n\
  \n\
  trap cleanup SIGTERM SIGINT\n\
  \n\
  # 启动服务的函数\n\
  start_server() {\n\
  dart run bin/server.dart &\n\
  SERVER_PID=$!\n\
  echo "✅ 服务已启动 (PID: $SERVER_PID)"\n\
  }\n\
  \n\
  # 首次启动服务\n\
  start_server\n\
  \n\
  # 监听文件变化\n\
  while true; do\n\
  # 使用 inotifywait 监听文件变化（阻塞直到有变化）\n\
  if inotifywait -q -r -e modify,create,delete,move --exclude ".*\\.swp|.*~" \\\n\
  lib/ bin/ database/ scripts/ 2>/dev/null; then\n\
  \n\
  echo ""\n\
  echo "🔄 检测到代码变化，重启服务..."\n\
  \n\
  # 杀掉旧进程\n\
  kill $SERVER_PID 2>/dev/null || true\n\
  wait $SERVER_PID 2>/dev/null || true\n\
  \n\
  # 等待一小段时间，避免频繁重启\n\
  sleep 1\n\
  \n\
  # 重新启动服务\n\
  start_server\n\
  else\n\
  # 如果 inotifywait 失败，等待后重试\n\
  sleep 2\n\
  fi\n\
  done' > /app/hot-reload.sh && \
  chmod +x /app/hot-reload.sh

# 暴露端口
EXPOSE 8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# 开发环境使用热重载脚本启动
CMD ["/app/hot-reload.sh"]

